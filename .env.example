# Meta (Facebook) app credentials — App Dashboard → Settings → Basic
META_APP_SECRET=
# Any random string; must match the Verify Token entered in App Dashboard → Webhooks
META_WEBHOOK_VERIFY_TOKEN=
# Long-lived Page access token (System User token recommended) with
# leads_retrieval + pages_show_list + pages_read_engagement + pages_manage_metadata
META_PAGE_ACCESS_TOKEN=
# Graph API version used for lead reads (optional)
META_GRAPH_VERSION=v23.0

# CRM endpoint that receives normalized leads (and data-deletion notices).
# Leave empty to only log incoming leads (visible in Vercel logs).
CRM_LEAD_WEBHOOK_URL=
# Optional bearer token sent as Authorization header to the CRM endpoint
CRM_LEAD_WEBHOOK_TOKEN=
